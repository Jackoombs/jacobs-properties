---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import ProcessSteps from "@/components/marketing/ProcessSteps";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import Reviews from "@/components/marketing/Reviews";
import PropertyCard from "@/components/property/PropertyCard";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("landlordsPage", "content");
if (!page) throw new Error("landlords-page content missing from CMS");
const { data } = page;

const faqs = (await getCollection("faqs")).filter((f) => f.data.category === "landlords").slice(0, 5);
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const lettingProperties = (await getCollection("properties")).filter((p) => p.data.marketingMode === "letting").slice(0, 3);
---

<StandardLayout title={data.seoTitle ?? "Landlords"} description={data.seoDescription ?? ""}>
  <ContentSection
    label={data.hero.label}
    heading={data.hero.heading}
    body={data.hero.body}
    image={cmsImageUrl(data.hero.image)}
    imageAlt={data.hero.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    cta1={{ type: "get-in-touch", text: data.hero.ctaPrimaryText ?? "Get in Touch" }}
    cta2={{ type: "expert-valuation", text: data.hero.ctaSecondaryText ?? "Book rental valuation" }}
  />

  <WhyUsSection
    heading="Four reasons you should let with us"
    image={cmsImageUrl(data.whyLetImage)}
    imageAlt={data.whyLetImageAlt}
    items={data.valueProps}
  />

  <ContentSection
    label={data.fullyManaged.label}
    heading={data.fullyManaged.heading}
    body={data.fullyManaged.body}
    image={cmsImageUrl(data.fullyManaged.image)}
    imageAlt={data.fullyManaged.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    cta1={{ type: "get-in-touch", text: "Get in touch" }}
    cta2={{ type: "link", text: "Letting Fees", link: "/Jacobs Properties Landord Fees.pdf", newTab: true }}
  />

  <ContentSection
    label={data.letOnly.label}
    heading={data.letOnly.heading}
    body={data.letOnly.body}
    image={cmsImageUrl(data.letOnly.image)}
    imageAlt={data.letOnly.imageAlt}
    imageSide="left"
    cta1={{ type: "get-in-touch", text: "Get in touch" }}
    cta2={{ type: "link", text: "Letting Fees", link: "/Jacobs Properties Landord Fees.pdf", newTab: true }}
  />

  <Section bgColor="bg-primary-200">
    <ProcessSteps client:visible heading="Our lettings process at a glance" steps={data.processSteps} />
  </Section>

  <Section>
    <SectionHeader className="lg:text-center" padding="misc">Frequently asked questions</SectionHeader>
    <div class="flex w-full flex-col gap-8 lg:items-center lg:gap-16">
      <FaqAccordion client:visible cardBg="bg-primary-200" faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
      <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
    </div>
  </Section>

  <ContentSection
    heading="Want to sell your home instead?"
    body="If you're thinking of selling as well as letting, we can help with both — start with a free valuation."
    cta1={{ type: "link", text: "Get a free valuation", link: "/valuation" }}
    bgColor="bg-primary-200"
  />

  <ContentSection
    label={data.brochureCta.label}
    heading={data.brochureCta.heading}
    body={data.brochureCta.body}
    image={cmsImageUrl(data.brochureCta.image)}
    imageAlt={data.brochureCta.imageAlt}
    imageSide="right"
    cta1={{ type: "brochure", text: "Download the guide", buyOrRent: "rent", pdfUrl: "/Jacobs properties - Guide To Letting.pdf" }}
  />

  <Section bgColor="bg-primary-200">
    <SectionHeader padding="misc">Happy agents make happy customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} />
  </Section>

  {
    lettingProperties.length > 0 && (
      <Section>
        <SectionHeader padding="misc">Success! We've just let these properties!</SectionHeader>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {lettingProperties.map((property) => (
            <PropertyCard client:visible property={property.data} />
          ))}
        </div>
      </Section>
    )
  }
</StandardLayout>
