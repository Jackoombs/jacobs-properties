---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import SplitHero from "@/components/marketing/SplitHero.astro";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("areaGuidesPage", "content");
if (!page) throw new Error("area-guides-page content missing from CMS");
const { data } = page;

const guides = await getCollection("areaGuides");
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<StandardLayout title={data.seoTitle ?? "Area Guides"} description={data.seoDescription ?? ""}>
  <SplitHero
    heading={data.heroHeading ?? "Area guides"}
    body={data.heroBody}
    cta={{ type: "get-in-touch", text: "Get in touch" }}
  />

  <Section className="grid gap-6 lg:grid-cols-2 lg:gap-16" disablePb>
    {
      guides.map((guide) => {
        // A guide with no sections has no page yet (see [slug].astro), so its
        // tile is shown but not linked, as Oakley was in the original.
        const hasPage = guide.data.sections.length > 0;
        const Tile = hasPage ? "a" : "div";
        const image = cmsImageUrl(guide.data.heroImage);
        return (
          <Tile
            href={hasPage ? `/area-guides/${guide.data.slug}` : undefined}
            class="group relative block aspect-property w-full rounded-big bg-primary-200"
          >
            {image && <img src={image} alt="" loading="lazy" class="absolute inset-0 h-full w-full rounded-big object-cover" />}
            {/* A name bar along the foot of the photo that swells to cover it on hover. */}
            <div class="absolute bottom-0 flex h-full max-h-14 w-full items-center rounded-b-big bg-[#001129]/95 transition-[max-height,border-radius] duration-300 ease-in-out group-hover:max-h-full group-hover:rounded-t-big md:max-h-24">
              <SectionHeader className="pl-10" textColor="text-white">{guide.data.name}</SectionHeader>
            </div>
          </Tile>
        );
      })
    }
  </Section>

  <Section>
    <SectionHeader className="md:text-center" padding="misc">Hear from our customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} variant="alt" />
  </Section>
</StandardLayout>
