---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader, Display } from "@/components/common/Text";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import ProcessSteps from "@/components/marketing/ProcessSteps";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import Reviews from "@/components/marketing/Reviews";
import Stats from "@/components/marketing/Stats";
import PropertyCarousel from "@/components/property/PropertyCarousel";
import InlineBrochureForm from "@/components/forms/brochure/InlineBrochureForm";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("sellersPage", "content");
if (!page) throw new Error("sellers-page content missing from CMS");
const { data } = page;

const faqs = (await getCollection("faqs")).filter((f) => f.data.category === "sellers").slice(0, 5);
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const sellingProperties = (await getCollection("properties"))
  .filter((p) => p.data.marketingMode === "selling")
  .map((p) => p.data);
---

<StandardLayout title={data.seoTitle ?? "Sellers"} description={data.seoDescription ?? ""}>
  <ContentSection
    label={data.hero.label}
    heading={data.hero.heading}
    body={data.hero.body}
    image={cmsImageUrl(data.hero.image)}
    imageAlt={data.hero.imageAlt}
    imageSide="right"
    imageAspect="aspect-property"
    headingSize="page"
    bgColor="bg-primary-200"
    labelPadding="hero-lg"
    bodyPadding="hero-lg"
    bodySize="lg"
    contentClassName="md:max-w-lg"
    ctaSize="lg"
    cta2Variant="secondary"
    cta1={{ type: "instant-valuation", text: data.hero.ctaPrimaryText ?? "Instant Valuation" }}
    cta2={{ type: "expert-valuation", text: data.hero.ctaSecondaryText ?? "Expert Valuation" }}
  />

  <Section className="flex flex-col gap-8 lg:items-center lg:text-center">
    <Display>{data.missionHeading}</Display>
    <h3
      class="max-w-xl text-[1.5rem] font-semibold leading-7 text-primary-100 lg:max-w-[51rem] lg:text-[2rem] lg:leading-10"
    >
      {data.missionSubheading}
    </h3>
  </Section>

  <WhyUsSection
    heading="Why sell your home with us"
    image={cmsImageUrl(data.whySellImage)}
    imageAlt={data.whySellImageAlt}
    items={data.valueProps}
    bgColor="bg-primary-200"
    cardBg="bg-white"
  />

  <Section>
    <Stats client:visible statType="selling" />
  </Section>

  <Section bgColor="bg-primary-200">
    <ProcessSteps client:visible heading="Our selling process at a glance" steps={data.processSteps} />
  </Section>

  <ContentSection
    label={data.provenRecipe.label}
    heading={data.provenRecipe.heading}
    body={data.provenRecipe.body}
    image={cmsImageUrl(data.provenRecipe.image)}
    imageAlt={data.provenRecipe.imageAlt}
    imageSide="left"
    contentClassName="max-w-2xl 2xl:pl-20"
    headingClassName="lg:max-w-lg"
  />

  <ContentSection
    label={data.brochureCta.label}
    heading={data.brochureCta.heading}
    body={data.brochureCta.body}
    image={cmsImageUrl(data.brochureCta.image)}
    imageAlt={data.brochureCta.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    bodySize="md"
    labelPadding="none"
    labelClassName="pb-3"
    headingPadding="none"
    headingClassName="pb-4"
    bodyPadding="none"
    bodyClassName="pb-5"
    contentClassName="lg:max-w-xl lg:justify-center"
  >
    <InlineBrochureForm
      client:visible
      slot="cta"
      buyOrRent="buy"
      pdfUrl="/Jacobs properties - Guide To Selling.pdf"
      buttonText="Download Guide"
    />
  </ContentSection>

  <Section>
    <PropertyCarousel
      client:visible
      heading="Your property could be one of them"
      properties={sellingProperties}
    />
  </Section>

  <Section bgColor="bg-primary-200">
    <SectionHeader className="lg:text-center" padding="misc">Hear from our customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} />
  </Section>

  <Section>
    <SectionHeader className="lg:text-center" padding="misc">Frequently asked questions</SectionHeader>
    <div class="flex w-full flex-col gap-8 lg:items-center lg:gap-16">
      <FaqAccordion client:visible cardBg="bg-primary-200" faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
      <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
    </div>
  </Section>
</StandardLayout>
