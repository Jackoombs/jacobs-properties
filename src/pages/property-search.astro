---
import { getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import PropertySearch from "@/components/property-search/PropertySearch";
import { BASINGSTOKE_CENTER } from "@/lib/constants";

const properties = await getCollection("properties");
---

<StandardLayout
  title="Search Properties for Sale and to Let in Basingstoke | Jacobs Properties"
  description="Search properties for sale in Basingstoke with Jacobs Properties. Our local estate agents are here to help you find your dream home."
>
  <PropertySearch client:load properties={properties.map((p) => p.data)} center={BASINGSTOKE_CENTER} />
</StandardLayout>
