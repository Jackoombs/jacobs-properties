---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import Link from "@/components/common/Link";
import SplitHero from "@/components/marketing/SplitHero.astro";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import TeamSlider from "@/components/marketing/TeamSlider";
import NewsSlider from "@/components/marketing/NewsSlider";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl, heroBgClass } from "@/lib/cms";

const page = await getEntry("aboutPage", "content");
if (!page) throw new Error("about-page content missing from CMS");
const { data } = page;

const teamMembers = (await getCollection("teamMembers"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(({ data: member }) => ({
    name: member.name,
    role: member.role,
    bio: member.bio,
    image: cmsImageUrl(member.photo),
    email: member.email,
    linkedInUrl: member.linkedInUrl,
  }));
const newsArticles = (await getCollection("newsArticles"))
  .sort((a, b) => (b.data.publishedDate ?? "").localeCompare(a.data.publishedDate ?? ""))
  .map(({ data: article }) => ({
    title: article.title,
    href: `/news/${article.slug}`,
    category: article.category,
    publishedDate: article.publishedDate,
    image: cmsImageUrl(article.heroImage),
  }));
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const faqs = (await getCollection("faqs")).filter((f) => f.data.featuredHome).slice(0, 5);

// The original broke this heading after the first question. The CMS holds it as
// one line, so put the break back at render time.
const ctaHeading = data.ctaSection.heading.replace("? ", "?\n");
---

<StandardLayout title={data.seoTitle ?? "About Us"} description={data.seoDescription ?? ""}>
  <SplitHero
    layout="grid"
    bgColor={heroBgClass(data.hero.bgVariant)}
    heading={data.hero.heading}
    body={data.hero.body}
    cta={data.hero.ctaPrimaryText ? { type: "get-in-touch", text: data.hero.ctaPrimaryText } : undefined}
  />

  <ContentSection
    label={data.personalPledge.label}
    heading={data.personalPledge.heading}
    body={data.personalPledge.body}
    image={cmsImageUrl(data.personalPledge.image)}
    imageAlt={data.personalPledge.imageAlt}
    imageSide="right"
    imageAspect="aspect-square"
    eagerImage
    labelPadding="hero-lg"
    headingClassName="lg:max-w-lg"
    bodySize="md"
    bodyPadding="none"
    bodyClassName="max-w-2xl whitespace-pre-line pb-[1.25em] last:pb-6 2xl:last:pb-7"
  />

  <ContentSection
    label={data.aboutCompany.label}
    heading={data.aboutCompany.heading}
    body={data.aboutCompany.body}
    image={cmsImageUrl(data.aboutCompany.image)}
    imageAlt={data.aboutCompany.imageAlt}
    imageSide="left"
    imageAspect="aspect-property"
    disablePt
    labelPadding="hero-lg"
    headingClassName="lg:max-w-lg"
    bodySize="md"
    bodyPadding="none"
    bodyClassName="pb-[1.25em] last:pb-6 2xl:last:pb-7"
    contentClassName="max-w-3xl 2xl:pl-20"
  />

  <WhyUsSection
    heading={data.teamSectionHeading ?? "Get to know these friendly faces"}
    image={cmsImageUrl(data.teamSectionImage)}
    imageClass="order-1 aspect-[6/5] h-auto w-full self-center object-cover lg:order-none"
    items={data.valueProps}
    bgColor="bg-primary-200"
    cardBg="bg-white"
  />

  <Section>
    <TeamSlider client:visible heading="The team behind Jacobs Property" members={teamMembers} />
    <Link link="/meet-the-team" type="secondary" size="lg" className="mx-auto mt-16">View full team</Link>
  </Section>

  <ContentSection
    label={data.ctaSection.label ?? "About"}
    heading={ctaHeading}
    body={data.ctaSection.body}
    image={cmsImageUrl(data.ctaSection.image)}
    imageAlt={data.ctaSection.imageAlt}
    imageSide="right"
    disablePt
    headingClassName="whitespace-pre-line"
    ctaSize="lg"
    cta1={{ type: "get-in-touch", text: data.ctaSection.ctaText ?? "Get in touch" }}
  />

  <Section bgColor="bg-primary-200">
    <NewsSlider client:visible heading="Read the latest property news" articles={newsArticles} />
  </Section>

  <Section>
    <SectionHeader className="lg:text-center" padding="misc">This is why we do what we do</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} />
  </Section>

  <Section bgColor="bg-primary-200" className="flex flex-col gap-8 md:justify-center md:gap-16">
    <SectionHeader className="md:text-center">Frequently asked questions</SectionHeader>
    <FaqAccordion client:visible faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
    <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
  </Section>
</StandardLayout>
