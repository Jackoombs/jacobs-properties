---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { PageHeader, SectionHeader } from "@/components/common/Text";
import Copy from "@/components/common/Copy";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import ValuationLink from "@/components/marketing/ValuationLink";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("valuationPage", "content");
if (!page) throw new Error("valuation-page content missing from CMS");
const { data } = page;

const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// The original broke this heading after the question. The CMS holds it as one
// line, so put the break back at render time.
const readyToSellHeading = data.readyToSell.heading.replace("? ", "?\n");
---

<StandardLayout title={data.seoTitle ?? "Valuation"} description={data.seoDescription ?? ""}>
  <Section bgColor="bg-primary-100" className="grid gap-6 lg:grid-cols-2 xl:gap-16">
    <div class="flex max-w-[45.5rem] flex-col justify-center">
      <PageHeader textColor="text-white" padding="hero">
        {data.heroHeading ?? "Find out how much your property is worth"}
      </PageHeader>
      {data.heroBody && <Copy size="lg" textColor="text-white">{data.heroBody}</Copy>}
    </div>
    <div class="flex flex-col gap-10 xl:gap-16">
      <ValuationLink
        client:idle
        valuationType="expert"
        backgroundColor="bg-white"
        className="max-w-[16rem] sm:max-w-[36rem]"
      >
        Book an in-person valuation at a time that suits you.
      </ValuationLink>
      <ValuationLink client:idle valuationType="instant" backgroundColor="bg-secondary-100">
        Get a free and instant estimate of your home’s value in just a few clicks.
      </ValuationLink>
    </div>
  </Section>

  <WhyUsSection
    heading="Why choose us to value your home?"
    image={cmsImageUrl(data.whyValueImage)}
    imageAlt={data.whyValueImageAlt}
    items={data.valueProps}
  />

  <ContentSection
    label={data.readyToSell.label}
    heading={readyToSellHeading}
    image={cmsImageUrl(data.readyToSell.image)}
    imageAlt={data.readyToSell.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    contentClassName="max-w-2xl md:max-w-lg"
    headingClassName="whitespace-pre-line"
    ctaSize="lg"
    cta1Variant="secondary"
    cta1={{ type: "expert-valuation", text: data.readyToSell.ctaText ?? "Request a valuation" }}
  />

  <Section>
    <SectionHeader className="lg:text-center" padding="misc">Our customers said</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} />
  </Section>
</StandardLayout>
