---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import SplitHero from "@/components/marketing/SplitHero.astro";
import TeamGrid from "@/components/marketing/TeamGrid";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("teamPage", "content");
if (!page) throw new Error("team-page content missing from CMS");
const { data } = page;

const teamMembers = (await getCollection("teamMembers"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(({ data: member }) => ({
    name: member.name,
    role: member.role,
    bio: member.bio,
    image: cmsImageUrl(member.photo),
    email: member.email,
    linkedInUrl: member.linkedInUrl,
  }));
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<StandardLayout title={data.seoTitle ?? "Meet the Team"} description={data.seoDescription ?? ""}>
  <SplitHero
    layout="grid"
    heading={data.heroHeading ?? "Meet your team of local property experts"}
    body={data.heroBody}
    cta={{ type: "get-in-touch", text: "Get in touch" }}
  />

  <Section>
    <TeamGrid client:visible members={teamMembers} />
  </Section>

  <Section disablePt>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} variant="alt" />
  </Section>
</StandardLayout>
