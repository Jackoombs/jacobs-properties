---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import SplitHero from "@/components/marketing/SplitHero.astro";
import NewsGrid from "@/components/marketing/NewsGrid";
import ValuationSection from "@/components/marketing/ValuationSection.astro";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("newsPage", "content");
if (!page) throw new Error("news-page content missing from CMS");
const { data } = page;

const articles = (await getCollection("newsArticles"))
  .sort((a, b) => (b.data.publishedDate ?? "").localeCompare(a.data.publishedDate ?? ""))
  .map(({ data: article }) => ({
    title: article.title,
    href: `/news/${article.slug}`,
    category: article.category,
    publishedDate: article.publishedDate,
    image: cmsImageUrl(article.heroImage),
  }));
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<StandardLayout title={data.seoTitle ?? "News"} description={data.seoDescription ?? ""}>
  <SplitHero
    plainHeading
    heading={data.heroHeading ?? "Latest industry news"}
    body={data.heroBody}
    cta={{ type: "get-in-touch", text: "Get in touch" }}
  />

  <Section>
    <NewsGrid client:visible articles={articles} />
  </Section>

  <ValuationSection title="Ready to sell your home?" />

  <Section>
    <SectionHeader className="md:text-center" padding="misc">Hear from our customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} variant="alt" />
  </Section>
</StandardLayout>
