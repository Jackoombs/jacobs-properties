---
import { getCollection, type CollectionEntry } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import Copy from "@/components/common/Copy";
import ImageCarousel from "@/components/property/ImageCarousel";
import PropertyDetails from "@/components/property/PropertyDetails";
import PropertyCarousel from "@/components/property/PropertyCarousel";
import { BedsBaths, StatusBadge } from "@/components/property/PropertyFacts";
import BookAViewingButton from "@/components/forms/book-a-viewing/BookAViewingButton";
import ShareButton from "@/components/property/ShareButton";
import StampDutyCalc from "@/components/marketing/calculators/StampDutyCalc";
import MortgageCalc from "@/components/marketing/calculators/MortgageCalc";
import { priceNumberToPriceString, toLatLng, truncateDescription } from "@/lib/property-utils";

export async function getStaticPaths() {
  const properties = await getCollection("properties");
  return properties.map((entry) => ({
    params: { id: entry.id },
    props: { property: entry.data, allProperties: properties.map((p) => p.data) },
  }));
}

type Props = {
  property: CollectionEntry<"properties">["data"];
  allProperties: CollectionEntry<"properties">["data"][];
};

const { property, allProperties } = Astro.props;
const {
  id,
  marketingMode,
  statusLabel,
  description,
  address1,
  address2,
  publicAddress,
  price,
  bedrooms,
  bathrooms,
  images,
  floorplan,
  epc,
  virtualTour,
  brochure,
  location,
} = property;

const displayAddress = address1 && address2 ? `${address1}, ${address2}` : publicAddress ?? "";
const priceString = priceNumberToPriceString(price);
const shortDescription = truncateDescription(description || "", 20);

const similarProperties = allProperties
  .filter((p) => p.marketingMode === marketingMode && p.id !== id)
  .sort((a, b) => Math.abs(a.price - price) - Math.abs(b.price - price))
  .slice(0, 10);
---

<StandardLayout
  title={`${displayAddress} | Property Details | Jacobs Properties`}
  description={`Discover more about ${displayAddress}. Our experienced estate agents provide detailed property information and are here to help you find your dream home. ${shortDescription}`}
>
  <section class="py-10 md:pb-28">
    <div class="mx-auto flex w-full max-w-container-lg flex-col gap-4 xl:flex-row xl:justify-between xl:gap-16">
      <ImageCarousel client:load images={images} />
      <div class="grid flex-1 sm:max-w-[34rem] xl:grid-rows-[1fr_auto_1fr]">
        <a
          href="/property-search"
          class="hidden w-max pb-6 text-[0.75rem] font-semibold uppercase leading-[1.1] tracking-[2.8px] text-primary-100 duration-100 hover:text-secondary-100 lg:text-[0.875rem] xl:block"
        >
          Back to properties
        </a>
        <div class="flex flex-col gap-2 lg:gap-5">
          <StatusBadge label={statusLabel} />
          <BedsBaths bedrooms={bedrooms} bathrooms={bathrooms} />
          <div class="pb-4 lg:pb-0">
            <SectionHeader as="h1" className="lg:pb-2">{displayAddress}</SectionHeader>
            <SectionHeader as="p">{priceString}</SectionHeader>
          </div>
          {
            description && (
              <Copy className="mb-3 line-clamp-3 text-ellipsis whitespace-pre-line" size="lg">
                {description}
              </Copy>
            )
          }
          <div class="flex flex-col gap-3 sm:flex-row">
            <BookAViewingButton
              client:idle
              size="lg"
              price={price}
              address={displayAddress}
              propertyId={id}
              buyOrRent={marketingMode === "letting" ? "rent" : "buy"}
            >
              Book a viewing
            </BookAViewingButton>
            <ShareButton client:idle name="property" size="lg" variant="secondary">Share Property</ShareButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PropertyDetails
    client:visible
    details={{ description: description || "", floorplan, epc, images, virtualTour }}
    location={toLatLng(location)}
    address={displayAddress}
    price={price}
    id={id}
    brochure={brochure}
    marketingMode={marketingMode}
  />

  <Section>
    <SectionHeader padding="misc">Try one of our useful calculators…</SectionHeader>
    <div class="flex w-full flex-col gap-7 lg:flex-row xl:gap-16">
      <StampDutyCalc client:visible />
      <MortgageCalc client:visible />
    </div>
  </Section>

  {
    similarProperties.length > 0 && (
      <Section bgColor="bg-primary-200">
        <PropertyCarousel client:idle heading="Similar Properties" properties={similarProperties} />
      </Section>
    )
  }
</StandardLayout>
