---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import Link from "@/components/common/Link";
import ContactItem from "@/components/common/ContactItem";
import SplitHero from "@/components/marketing/SplitHero.astro";
import ContentSection from "@/components/marketing/ContentSection.astro";
import Reviews from "@/components/marketing/Reviews";
import PropertyMap from "@/components/property/PropertyMap";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("contactPage", "content");
if (!page) throw new Error("contact-page content missing from CMS");
const { data } = page;

const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const branchLocation = data.mapLat && data.mapLng ? { lat: data.mapLat, lng: data.mapLng } : undefined;

// The original set the address on two lines: building and street, then town and
// postcode. The CMS holds it as one line, so break it after the second part.
const addressParts = data.addressLine?.split(", ") ?? [];
const addressLines =
  addressParts.length > 2
    ? [`${addressParts.slice(0, 2).join(", ")},`, addressParts.slice(2).join(", ")]
    : addressParts;
---

<StandardLayout title={data.seoTitle ?? "Contact Us"} description={data.seoDescription ?? ""}>
  <SplitHero
    heading={data.heroHeading ?? "Contact us"}
    body={data.heroBody}
    cta={{ type: "get-in-touch", text: "Get in touch" }}
  />

  <ContentSection
    label="Contact"
    heading="Branch details"
    image={cmsImageUrl(data.branchImage)}
    imageAlt={data.branchImageAlt || "Worting House"}
    imageSide="left"
    contentClassName="max-w-3xl xl:pl-32"
  >
    <div slot="cta">
      <div class="pb-10">
        {data.phone && <ContactItem className="pb-3" icon="phone" link={data.phone.replace(/\s+/g, "")}>{data.phone}</ContactItem>}
        {data.email && <ContactItem className="pb-7" icon="mail" link={data.email}>{data.email}</ContactItem>}
        {
          addressLines.length > 0 && (
            <ContactItem icon="pin" link="#map">
              {addressLines.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))}
            </ContactItem>
          )
        }
      </div>
      {
        data.directionsUrl && (
          <Link newTab link={data.directionsUrl} type="secondary" size="lg">
            Get Directions
          </Link>
        )
      }
    </div>
  </ContentSection>

  <Section disablePt disablePb>
    <div id="map">
      {branchLocation && <PropertyMap client:visible location={branchLocation} markers={[branchLocation]} zoom={15} />}
    </div>
  </Section>

  <Section>
    <SectionHeader className="md:text-center" padding="misc">Hear from our customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} variant="alt" />
  </Section>
</StandardLayout>
