---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader } from "@/components/common/Text";
import Copy from "@/components/common/Copy";
import SplitHero from "@/components/marketing/SplitHero.astro";
import FaqPageList from "@/components/marketing/FaqPageList";
import ValuationSection from "@/components/marketing/ValuationSection.astro";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("faqPage", "content");
if (!page) throw new Error("faq-page content missing from CMS");
const { data } = page;

const faqs = (await getCollection("faqs")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// The banner copy quotes the branch phone number in bold. Take it from the
// contact page so the two never drift, and make it a tap-to-call link.
const contact = await getEntry("contactPage", "content");
const phone = contact?.data.phone;
const [beforePhone, afterPhone] =
  phone && data.ctaBody?.includes(phone) ? data.ctaBody.split(phone) : [data.ctaBody, undefined];
---

<StandardLayout title={data.seoTitle ?? "FAQs"} description={data.seoDescription ?? ""}>
  <SplitHero
    bgColor="bg-primary-100"
    textColor="text-white"
    plainHeading
    heading={data.heroHeading ?? "Frequently asked questions at Jacobs"}
    body={data.heroBody}
    cta={{ type: "get-in-touch", text: "Get in touch" }}
  />

  <Section>
    <FaqPageList client:load faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer, category: f.data.category }))} />
  </Section>

  <ValuationSection
    label="Get in touch"
    title={data.ctaHeading ?? "Not found what you’re looking for?"}
    tagline=""
    headingClassName="lg:max-w-lg"
    image={cmsImageUrl(data.ctaImage)}
    reverseButtons
  >
    {
      beforePhone && (
        <Copy size="lg" padding="hero-md" className="lg:max-w-md xl:max-w-xl">
          {beforePhone}
          {afterPhone !== undefined && (
            <>
              <a href={`tel:${phone?.replace(/\s+/g, "")}`} class="font-semibold">
                {phone}
              </a>
              {afterPhone}
            </>
          )}
        </Copy>
      )
    }
  </ValuationSection>

  <Section>
    <SectionHeader className="md:text-center" padding="misc">Hear from our customers</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} variant="alt" />
  </Section>
</StandardLayout>
