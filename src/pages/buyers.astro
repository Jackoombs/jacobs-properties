---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader, Display } from "@/components/common/Text";
import PropertySearchBar from "@/components/marketing/PropertySearchBar";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import ProcessSteps from "@/components/marketing/ProcessSteps";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import ValuationSection from "@/components/marketing/ValuationSection.astro";
import StampDutyCalc from "@/components/marketing/calculators/StampDutyCalc";
import MortgageCalc from "@/components/marketing/calculators/MortgageCalc";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("buyersPage", "content");
if (!page) throw new Error("buyers-page content missing from CMS");
const { data } = page;

const faqs = (await getCollection("faqs")).filter((f) => f.data.category === "buyers").slice(0, 5);
---

<StandardLayout title={data.seoTitle ?? "Buyers"} description={data.seoDescription ?? ""}>
  <ContentSection
    label={data.hero.label}
    heading={data.hero.heading}
    body={data.hero.body}
    image={cmsImageUrl(data.hero.image)}
    imageAlt={data.hero.imageAlt}
    imageSide="right"
    imageAspect="aspect-property"
    headingSize="page"
    bgColor="bg-primary-200"
    labelPadding="hero-lg"
    bodyPadding="hero-lg"
    bodySize="lg"
    contentClassName="md:max-w-xl"
    ctaSize="lg"
    cta2Variant="secondary"
    cta1={{ type: "link", text: data.hero.ctaPrimaryText ?? "Start searching", link: data.hero.ctaPrimaryLink ?? "/property-search" }}
    cta2={data.hero.ctaSecondaryText ? { type: "get-in-touch", text: data.hero.ctaSecondaryText } : undefined}
  />

  <Section bgColor="bg-primary-200" disablePt className="flex flex-col items-center gap-8 text-center lg:gap-16">
    <Display>Find your dream home today</Display>
    <PropertySearchBar client:visible />
  </Section>

  <WhyUsSection
    heading="Why buy a property with Jacobs?"
    image={cmsImageUrl(data.whyBuyImage)}
    imageAlt={data.whyBuyImageAlt}
    items={data.valueProps}
  />

  <Section bgColor="bg-primary-200">
    <ProcessSteps client:visible heading="8 steps to buying a home with us" steps={data.processSteps} />
  </Section>

  <Section className="flex flex-col gap-8 md:justify-center md:gap-16">
    <SectionHeader className="md:text-center">Frequently asked questions</SectionHeader>
    <FaqAccordion client:visible cardBg="bg-primary-200" faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
    <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
  </Section>

  <Section bgColor="bg-primary-200">
    <div class="grid w-full flex-col gap-6 lg:grid-cols-2 xl:gap-x-16">
      <SectionHeader>Find out how much you could borrow</SectionHeader>
      <SectionHeader>Find out how much tax you will pay for your new home</SectionHeader>
      <StampDutyCalc client:visible />
      <MortgageCalc client:visible />
    </div>
  </Section>

  <ValuationSection
    title={data.sellingCtaHeading ?? "Selling your property?"}
    body={data.sellingCtaBody}
    bodyClassName="lg:max-w-md xl:max-w-xl"
  />
</StandardLayout>
