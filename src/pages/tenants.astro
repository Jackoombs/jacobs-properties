---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { SectionHeader, Display } from "@/components/common/Text";
import PropertySearchBar from "@/components/marketing/PropertySearchBar";
import ContentSection from "@/components/marketing/ContentSection.astro";
import WhyUsSection from "@/components/marketing/WhyUsSection.astro";
import ProcessSteps from "@/components/marketing/ProcessSteps";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import Reviews from "@/components/marketing/Reviews";
import { cmsImageUrl } from "@/lib/cms";

const page = await getEntry("tenantsPage", "content");
if (!page) throw new Error("tenants-page content missing from CMS");
const { data } = page;

const faqs = (await getCollection("faqs")).filter((f) => f.data.category === "tenants").slice(0, 5);
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<StandardLayout title={data.seoTitle ?? "Tenants"} description={data.seoDescription ?? ""}>
  <ContentSection
    label={data.hero.label}
    heading={data.hero.heading}
    body={data.hero.body}
    image={cmsImageUrl(data.hero.image)}
    imageAlt={data.hero.imageAlt}
    imageSide="right"
    imageAspect="aspect-property"
    eagerImage
    headingSize="page"
    bgColor="bg-primary-200"
    labelPadding="hero-lg"
    bodyPadding="hero-lg"
    bodySize="lg"
    contentClassName="md:max-w-xl"
    ctaSize="lg"
    cta2Variant="secondary"
    cta1={{ type: "get-in-touch", text: data.hero.ctaPrimaryText ?? "Get in touch" }}
    cta2={{ type: "link", text: data.hero.ctaSecondaryText ?? "Report a repair", link: data.hero.ctaSecondaryLink ?? "/contact-us" }}
  />

  <Section bgColor="bg-primary-200" disablePt className="flex flex-col items-center gap-8 text-center lg:gap-16">
    <Display>Find a rental property here</Display>
    <PropertySearchBar client:visible defaultMode="rent" />
  </Section>

  <WhyUsSection
    heading="Why rent with us?"
    image={cmsImageUrl(data.whyRentImage)}
    imageAlt={data.whyRentImageAlt}
    imageClass="aspect-[1.2/1] w-full object-cover"
    items={data.valueProps}
  />

  <Section bgColor="bg-primary-200">
    <SectionHeader className="md:text-center" padding="misc">Frequently asked questions</SectionHeader>
    <div class="flex w-full flex-col gap-8 lg:items-center lg:gap-16">
      <FaqAccordion client:visible faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
      <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
    </div>
  </Section>

  <Section>
    <ProcessSteps client:visible heading="Renting with us is easy – here’s how" steps={data.processSteps} />
  </Section>

  <ContentSection
    label={data.reportRepair.label}
    heading={data.reportRepair.heading}
    body={data.reportRepair.body}
    image={cmsImageUrl(data.reportRepair.image)}
    imageAlt={data.reportRepair.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    contentClassName="max-w-2xl md:max-w-lg"
  />

  <ContentSection
    label={data.standardsRegulations.label}
    heading={data.standardsRegulations.heading}
    body={data.standardsRegulations.body}
    image={cmsImageUrl(data.standardsRegulations.image)}
    imageAlt={data.standardsRegulations.imageAlt}
    imageSide="left"
    bgColor="bg-primary-200"
    disablePt
    disablePb
    contentClassName="max-w-2xl lg:max-w-xl 2xl:pl-20"
  />

  <ContentSection
    label={data.questionRenting.label}
    heading={data.questionRenting.heading}
    image={cmsImageUrl(data.questionRenting.image)}
    imageAlt={data.questionRenting.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    contentClassName="max-w-2xl lg:max-w-xl"
    ctaSize="lg"
    cta1Variant="secondary"
    cta1={{ type: "get-in-touch", text: data.questionRenting.ctaText ?? "Ask us now" }}
  />

  <Section>
    <SectionHeader className="lg:text-center" padding="misc">Our customers are the best</SectionHeader>
    <Reviews client:visible variant="alt" reviews={reviews.map((r) => r.data)} />
  </Section>
</StandardLayout>
