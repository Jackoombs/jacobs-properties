---
import { getEntry, getCollection } from "astro:content";
import StandardLayout from "@/layouts/StandardLayout.astro";
import Section from "@/components/common/Section.astro";
import { Display, SectionHeader } from "@/components/common/Text";
import HomeHero from "@/components/marketing/HomeHero.astro";
import ContentSection from "@/components/marketing/ContentSection.astro";
import AudienceCarousel from "@/components/marketing/AudienceCarousel";
import PropertySearchBar from "@/components/marketing/PropertySearchBar";
import FaqAccordion from "@/components/marketing/FaqAccordion";
import Reviews from "@/components/marketing/Reviews";
import RecentlySoldLet from "@/components/property/RecentlySoldLet";
import { cmsImageUrl } from "@/lib/cms";
import { isSoldOrLetStatus } from "@/lib/property-utils";

const page = await getEntry("homePage", "content");
if (!page) throw new Error("home-page content missing from CMS");
const { data } = page;

const properties = await getCollection("properties");
// "Recently sold/let" is anything with a deal agreed or done: an offer accepted
// on a sale, a tenancy agreed or in place on a letting. Listings still on the
// market and withdrawn ones are both left out.
const soldProperties = properties
  .filter((p) => p.data.marketingMode === "selling" && isSoldOrLetStatus(p.data.status))
  .map((p) => p.data);
const letProperties = properties
  .filter((p) => p.data.marketingMode === "letting" && isSoldOrLetStatus(p.data.status))
  .map((p) => p.data);
const reviews = (await getCollection("reviews")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const faqs = (await getCollection("faqs")).filter((f) => f.data.featuredHome).slice(0, 5);
const audienceLinks = data.audienceLinks.map((item) => ({
  title: item.title,
  link: item.link,
  image: cmsImageUrl(item.image),
}));
---

<StandardLayout
  title={data.seoTitle ?? "Jacobs Properties"}
  description={data.seoDescription ?? ""}
  headerOverlay
>
  <HomeHero
    heading={data.hero.heading}
    body={data.hero.body}
    image={cmsImageUrl(data.hero.image)}
    imageAlt={data.hero.imageAlt}
    slides={data.heroSlides.map((slide) => ({
      src: cmsImageUrl(slide.image)!,
      alt: slide.imageAlt,
      focalPosition: slide.focalPosition,
    }))}
    cta1={{ type: "instant-valuation", text: data.hero.ctaPrimaryText ?? "Instant Valuation" }}
    cta2={{ type: "expert-valuation", text: data.hero.ctaSecondaryText ?? "Expert Valuation" }}
  />

  <Section bgColor="bg-primary-200" className="flex flex-col items-center gap-8 text-center lg:gap-16">
    <Display>Your property search starts here.</Display>
    <PropertySearchBar client:visible />
  </Section>

  <ContentSection
    label={data.aboutSection.label}
    heading={data.aboutSection.heading}
    body={data.aboutSection.body}
    image={cmsImageUrl(data.aboutSection.image)}
    imageAlt={data.aboutSection.imageAlt}
    imageSide="right"
    imageAspect="aspect-property"
    contentClassName="md:max-w-xl md:justify-center"
    headingClassName="md:max-w-[25rem] sm:max-w-none"
    cta1Variant="secondary"
    ctaSize="lg"
    bodySize="md"
    bodyClassName="lg:max-w-lg"
    cta1={{ type: "link", text: data.aboutSection.ctaText ?? "About us", link: data.aboutSection.ctaLink ?? "/about-us" }}
  />

  <Section bgColor="bg-primary-200">
    <AudienceCarousel client:visible heading="How can we Help?" links={audienceLinks} />
  </Section>

  {
    (soldProperties.length > 0 || letProperties.length > 0) && (
      <Section>
        <RecentlySoldLet
          client:visible
          soldProperties={soldProperties}
          letProperties={letProperties}
        />
      </Section>
    )
  }

  <ContentSection
    label={data.propertyReportSection.label}
    heading={data.propertyReportSection.heading}
    body={data.propertyReportSection.body}
    image={cmsImageUrl(data.propertyReportSection.image)}
    imageAlt={data.propertyReportSection.imageAlt}
    imageSide="right"
    bgColor="bg-primary-200"
    cta1Variant="secondary"
    ctaSize="lg"
    bodySize="md"
    headingPadding="none"
    headingClassName="pb-2 md:max-w-[30rem]"
    bodyPadding="none"
    bodyClassName="pb-5 max-w-md"
    contentClassName="lg:max-w-xl lg:justify-center"
    cta1={{ type: "link", text: data.propertyReportSection.ctaText ?? "Get Report", link: data.propertyReportSection.ctaLink ?? "#", newTab: true }}
  />

  <Section>
    <SectionHeader padding="misc" className="lg:text-center">This is why people love us</SectionHeader>
    <Reviews client:visible reviews={reviews.map((r) => r.data)} />
  </Section>

  <Section bgColor="bg-primary-200">
    <SectionHeader className="lg:text-center" padding="misc">Frequently asked questions</SectionHeader>
    <div class="flex w-full flex-col gap-8 lg:items-center lg:gap-16">
      <FaqAccordion client:visible faqs={faqs.map((f) => ({ id: f.id, question: f.data.question, answer: f.data.answer }))} />
      <a class="text-xs font-semibold uppercase tracking-[1.2px] text-primary-100 underline decoration-secondary-100 decoration-2 underline-offset-4 lg:text-center lg:text-[0.875rem] lg:underline-offset-8" href="/faq">See All Our Faqs</a>
    </div>
  </Section>
</StandardLayout>
