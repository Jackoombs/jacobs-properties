---
import ValuationHero from "@/assets/common/valuation-hero.webp";
import { SectionLabel, SectionHeader } from "@/components/common/Text";
import Copy from "@/components/common/Copy";
import InstantValuationButton from "@/components/forms/instant-valuation/InstantValuationButton";
import ExpertValuationButton from "@/components/forms/expert-valuation/ExpertValuationButton";

interface Props {
  title: string;
  label?: string;
  /** Overrides the bundled photo, e.g. with one from the CMS. */
  image?: string;
  /** Second heading line. Empty for pages whose title is the whole heading. */
  tagline?: string;
  body?: string;
  bodyClassName?: string;
  headingClassName?: string;
  /** The area guides banner in the original swapped the two button colours. */
  reverseButtons?: boolean;
}

const {
  title,
  label = "Valuation",
  image,
  tagline = "Find out how much it’s worth",
  body,
  bodyClassName,
  headingClassName,
  reverseButtons = false,
} = Astro.props;
---

<section
  class="relative flex flex-col justify-center gap-6 bg-secondary-100 pb-10 lg:aspect-[12/5] lg:pb-0"
>
  <img
    loading="lazy"
    class="right-0 top-0 mx-auto aspect-[6/5] h-auto w-full object-cover object-left lg:absolute lg:order-1 lg:w-[50vw]"
    src={image ?? ValuationHero.src}
    alt=""
  />
  <div class="mx-auto w-full max-w-container-lg">
    <div class="flex flex-1 flex-col lg:justify-center">
      <SectionLabel padding="hero-md">{label}</SectionLabel>
      <SectionHeader padding="hero" className={headingClassName}>
        {title}
        {
          tagline && (
            <>
              <br />
              {tagline}
            </>
          )
        }
      </SectionHeader>
      {body && <Copy size="lg" padding="hero-md" className={bodyClassName}>{body}</Copy>}
      <slot />
      <div class="flex flex-col gap-3 md:flex-row">
        <InstantValuationButton client:visible size="lg" variant={reverseButtons ? "white" : "primary"}>
          Instant Valuation
        </InstantValuationButton>
        <ExpertValuationButton client:visible size="lg" variant={reverseButtons ? "primary" : "white"}>
          Expert Valuation
        </ExpertValuationButton>
      </div>
    </div>
  </div>
</section>
